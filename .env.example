# Copy to .env and fill in real values. Never commit .env.

# GitLab API (required)
# Token: GitLab → Preferences → Access Tokens (api scope minimum)
GITLAB_TOKEN=glpat-your-token-here
# Project: numeric ID or URL-encoded path (e.g. group%2Fproject)
GITLAB_PROJECT_ID=12345678
# Instance URL (default below is gitlab.com). For self-hosted, set full API origin:
GITLAB_BASE_URL=https://gitlab.com
# Alternative host shorthand if base URL not set:
# GITLAB_HOST=gitlab.example.com

# Optional server metadata
# MCP_SERVER_NAME=gitlab-mcp
# MCP_SERVER_VERSION=1.0.0
# LOG_LEVEL=info

# API rate limit (requests per second)
# RATE_LIMIT_REQUESTS_PER_SECOND=10

# HTTP transport only (npm run start:http)
# MCP_HTTP_PORT=3101
