# Copy to .env and fill in real values. Never commit .env.

# GitLab API (required)
# Token: GitLab → Preferences → Access Tokens (api scope minimum)
GITLAB_TOKEN=glpat-your-token-here
# ── Scope: BOTH ARE OPTIONAL ──────────────────────────────────────────────────
# With neither set, the server runs token-only: any repo the token can see is reachable
# by numeric ID, full path ("group/repo"), or plain name (resolved by search).
# Setting a group narrows name lookups and avoids most ambiguity — recommended.
# Group ("space") to browse — this is the multi-repo mode. Numeric ID, or the group's
# URL-encoded full path (e.g. mycompany or mycompany%2Fplatform).
# With this set, call gitlab_list_group_projects to discover repos, then pass
# projectId to any other tool.
GITLAB_GROUP_ID=
# Optional default repo, used when a tool call omits projectId. Handy for single-repo
# setups; unnecessary when working group-wide. Numeric ID or URL-encoded path.
GITLAB_PROJECT_ID=
# Instance URL (default below is gitlab.com). For self-hosted, set full API origin:
GITLAB_BASE_URL=https://gitlab.com
# Alternative host shorthand if base URL not set:
# GITLAB_HOST=gitlab.example.com

# Optional server metadata
# MCP_SERVER_NAME=gitlab-mcp
# MCP_SERVER_VERSION=1.0.0
# LOG_LEVEL=info

# API rate limit (requests per second)
# RATE_LIMIT_REQUESTS_PER_SECOND=10

# HTTP transport only (npm run start:http)
# MCP_HTTP_PORT=3101
